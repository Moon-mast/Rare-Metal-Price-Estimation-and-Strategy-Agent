{
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "name": "critical-minerals-desk",
  "productName": "Critical Minerals Desk",
  "version": "1.0.4",
  "description": "稀有金属价格预估与策略 Agent 桌面端",
  "main": "main.js",
  "scripts": {
    "start": "electron ."
  },
  "author": "Moon-mast",
  "license": "MIT",
  "build": {
    "appId": "com.critical-minerals.desk",
    "productName": "Critical Minerals Desk",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "index.html",
      "agent-proxy.js",
      "manifest.webmanifest",
      "sw.js",
      "icons/",
      "electron.ico",
      "图标.png",
      "README.md",
      "启动桌面端.bat",
      "preload.js"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "electron.ico"
    },
    "artifactName": "Rare-Metal-Agent-Windows-${version}.${ext}",
    "asarUnpack": [
      "agent-proxy.js"
    ]
  }
}